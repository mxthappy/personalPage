---
import { SITE } from '../config';

const links = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/projects', label: '项目' },
  { href: '/about', label: '关于' }
];

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-white/5 bg-base/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-5">
    <a href="/" class="font-mono text-lg font-bold tracking-tight" aria-label="回到首页">
      <span class="text-gradient">mxt</span><span class="text-ink-dim">.dev</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-md px-3 py-2 text-sm transition',
            isActive(link.href)
              ? 'text-accent'
              : 'text-ink-dim hover:bg-white/5 hover:text-ink'
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <button
      id="menu-btn"
      type="button"
      class="rounded-md border border-white/10 p-2 text-ink-dim transition hover:text-ink md:hidden"
      aria-label="打开菜单"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/5 px-5 py-2 md:hidden">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'block rounded-md px-3 py-2.5 text-sm transition',
          isActive(link.href) ? 'text-accent' : 'text-ink-dim hover:bg-white/5 hover:text-ink'
        ]}
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden') ?? false;
    btn.setAttribute('aria-expanded', String(!isHidden));
    btn.setAttribute('aria-label', isHidden ? '打开菜单' : '关闭菜单');
  });
</script>
