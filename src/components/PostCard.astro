---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import { formatDate } from '../lib/format';

type Post = CollectionEntry<'posts'>;
const { post } = Astro.props;
---

<article class="glass group flex flex-col rounded-2xl p-6 transition duration-300 hover:-translate-y-0.5 hover:border-accent/30 hover:shadow-[0_0_30px_rgb(34_211_238/0.08)]">
  <a href={`/blog/${post.id}/`} class="flex h-full flex-col">
    <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-ink-dim">
      {formatDate(post.data.pubDate)}
    </time>
    <h3 class="mt-2 text-lg font-semibold text-ink transition group-hover:text-accent">
      {post.data.title}
    </h3>
    <p class="mt-2 flex-1 text-sm leading-6 text-ink-dim">
      {post.data.description}
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      {post.data.tags.map((tag) => <Tag tag={tag} />)}
    </div>
  </a>
</article>
