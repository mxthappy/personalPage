---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={project.data.name} description={project.data.description}>
  <article class="mx-auto max-w-3xl">
    <header class="mb-8">
      <div class="mb-3 flex items-center gap-3">
        {project.data.featured && (
          <span class="rounded-full border border-accent/30 bg-accent/10 px-2.5 py-0.5 text-xs text-accent">
            精选项目
          </span>
        )}
        <span class="font-mono text-sm text-ink-dim">{project.id}</span>
      </div>
      <h1 class="text-3xl font-bold md:text-4xl">{project.data.name}</h1>
      <p class="mt-4 text-base leading-7 text-slate-400">{project.data.description}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {project.data.techStack.map((tech) => (
          <span class="rounded-md bg-white/5 px-2.5 py-1 font-mono text-xs text-ink-dim">
            {tech}
          </span>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        {project.data.link && (
          <a
            href={project.data.link}
            target="_blank"
            rel="noopener"
            class="rounded-lg bg-gradient-to-r from-accent to-accent-2 px-5 py-2.5 text-sm font-semibold text-white transition hover:opacity-90"
          >
            访问链接 ↗
          </a>
        )}
        <a
          href="/projects"
          class="rounded-lg border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-medium text-slate-200 transition hover:bg-white/10"
        >
          ← 返回项目列表
        </a>
      </div>
    </header>

    <div class="article-body">
      <Content />
    </div>
  </article>
</Layout>
