---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config';

const skills = ['TypeScript', 'Node.js', 'React', 'Astro', 'Tailwind CSS', 'PostgreSQL'];
const stack = ['Astro', 'Tailwind CSS', 'Cloudflare Pages', 'GitHub'];
---

<Layout title="关于" description="关于我">
  <div class="mx-auto max-w-3xl">
    <header class="mb-10">
      <h1 class="text-3xl font-bold md:text-4xl">
        关于<span class="text-gradient">.</span>
      </h1>
    </header>

    <section class="glass mb-10 flex flex-col items-center gap-6 rounded-2xl p-8 sm:flex-row">
      <div
        class="flex h-24 w-24 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-accent to-accent-2 text-3xl font-bold text-white"
        aria-hidden="true"
      >
        {SITE.author.slice(0, 1)}
      </div>
      <div>
        <h2 class="text-xl font-bold">{SITE.author}</h2>
        <p class="mt-2 text-sm leading-6 text-ink-dim">
          开发者 · 坐标中国。喜欢折腾前端与全栈技术，热衷把想法落地成产品，
          也喜欢写文章分享踩坑经验。
        </p>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-xl font-bold">技能</h2>
      <div class="flex flex-wrap gap-2">
        {skills.map((skill) => (
          <span class="rounded-md bg-white/5 px-3 py-1.5 font-mono text-sm text-ink-dim">
            {skill}
          </span>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-xl font-bold">经历</h2>
      <ol class="space-y-6 border-l border-white/10 pl-6">
        <li class="relative">
          <span class="absolute -left-[27px] top-1.5 h-2.5 w-2.5 rounded-full bg-accent"></span>
          <p class="font-mono text-xs text-ink-dim">2024 — 至今</p>
          <h3 class="mt-1 font-semibold">全栈开发者</h3>
          <p class="mt-1 text-sm leading-6 text-ink-dim">负责 Web 应用的前后端开发与架构设计。</p>
        </li>
        <li class="relative">
          <span class="absolute -left-[27px] top-1.5 h-2.5 w-2.5 rounded-full bg-accent-2"></span>
          <p class="font-mono text-xs text-ink-dim">2022 — 2024</p>
          <h3 class="mt-1 font-semibold">前端开发</h3>
          <p class="mt-1 text-sm leading-6 text-ink-dim">专注前端工程化与产品体验。</p>
        </li>
      </ol>
    </section>

    <section>
      <h2 class="mb-4 text-xl font-bold">本站技术栈</h2>
      <div class="flex flex-wrap gap-2">
        {stack.map((tech) => (
          <span class="rounded-md bg-white/5 px-3 py-1.5 font-mono text-sm text-ink-dim">
            {tech}
          </span>
        ))}
      </div>
      <p class="mt-6 text-sm leading-6 text-ink-dim">
        想了解更多，欢迎通过
        <a href={`mailto:${SITE.email}`} class="text-accent underline underline-offset-4">
          邮件
        </a>
        或
        <a href={SITE.github} class="text-accent underline underline-offset-4" target="_blank" rel="noopener">
          GitHub
        </a>
        联系我。
      </p>
    </section>
  </div>
</Layout>
