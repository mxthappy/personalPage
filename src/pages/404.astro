---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面未找到" description="404 页面未找到">
  <div class="flex min-h-[55vh] flex-col items-center justify-center text-center">
    <p class="text-gradient font-mono text-7xl font-bold">404</p>
    <p class="mt-5 text-slate-400">这个页面不存在或已被移动。</p>
    <a
      href="/"
      class="mt-8 rounded-lg bg-gradient-to-r from-accent to-accent-2 px-5 py-2.5 text-sm font-semibold text-white transition hover:opacity-90"
    >
      返回首页
    </a>
  </div>
</Layout>
