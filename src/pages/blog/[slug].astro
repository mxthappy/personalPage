---
import Layout from '../../layouts/Layout.astro';
import Tag from '../../components/Tag.astro';
import Giscus from '../../components/Giscus.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, readingTime } from '../../lib/format';

export async function getStaticPaths() {
  const posts = (await getCollection('posts'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[index - 1] ?? null,
      older: posts[index + 1] ?? null
    }
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth <= 3);
const minutes = readingTime(post.body);
---

<Layout title={post.data.title} description={post.data.description} ogType="article">
  <article class="mx-auto max-w-3xl">
    <header class="mb-8">
      <div class="mb-4 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => <Tag tag={tag} />)}
      </div>
      <h1 class="text-3xl font-bold leading-snug md:text-4xl">{post.data.title}</h1>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-sm text-ink-dim">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>约 {minutes} 分钟</span>
      </p>
    </header>

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_200px] lg:gap-12">
      <div class="article-body min-w-0">
        <Content />
      </div>

      {toc.length > 0 && (
        <aside class="hidden lg:block">
          <nav class="sticky top-24 max-h-[70vh] overflow-y-auto border-l border-white/10 pl-4 text-sm">
            <p class="mb-3 font-mono text-xs uppercase tracking-wider text-ink-dim">目录</p>
            <ul class="space-y-2">
              {toc.map((heading) => (
                <li class={heading.depth > 2 ? 'pl-3' : ''}>
                  <a href={`#${heading.slug}`} class="text-ink-dim transition hover:text-accent">
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>

    <nav class="mt-12 grid gap-4 border-t border-white/10 pt-8 sm:grid-cols-2" aria-label="文章导航">
      {older && (
        <a
          href={`/blog/${older.id}/`}
          class="glass group rounded-xl p-4 transition hover:border-accent/30"
        >
          <p class="font-mono text-xs text-ink-dim">← 上一篇</p>
          <p class="mt-1.5 text-sm font-medium text-ink transition group-hover:text-accent">
            {older.data.title}
          </p>
        </a>
      )}
      {newer && (
        <a
          href={`/blog/${newer.id}/`}
          class="glass group rounded-xl p-4 text-right transition hover:border-accent/30"
        >
          <p class="font-mono text-xs text-ink-dim">下一篇 →</p>
          <p class="mt-1.5 text-sm font-medium text-ink transition group-hover:text-accent">
            {newer.data.title}
          </p>
        </a>
      )}
    </nav>

    <Giscus />
  </article>
</Layout>
